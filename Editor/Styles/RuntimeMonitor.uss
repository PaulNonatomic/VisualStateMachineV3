/* Runtime Monitor Stylesheet */

/* Monitor Window */
.runtime-monitor-window {
    flex-grow: 1;
    background-color: rgb(40, 40, 40);
}

/* Instance List */
.instance-list {
    flex-grow: 1;
    margin: 8px;
}

.instance-list .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 8px;
    background-color: rgb(55, 55, 55);
    border-radius: 4px 4px 0 0;
}

.instance-item {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin: 1px 0;
    background-color: rgb(50, 50, 50);
}

.instance-item:hover {
    background-color: rgb(60, 60, 60);
}

.instance-item.selected {
    background-color: rgb(45, 65, 85);
    border-left-width: 3px;
    border-left-color: rgb(68, 192, 255);
}

.instance-item .status-indicator {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 8px;
}

.instance-item .status-indicator.running {
    background-color: rgb(50, 200, 50);
}

.instance-item .status-indicator.paused {
    background-color: rgb(255, 200, 50);
}

.instance-item .status-indicator.stopped {
    background-color: rgb(150, 150, 150);
}

.instance-item .instance-name {
    flex-grow: 1;
}

.instance-item .current-state {
    color: rgb(150, 150, 150);
    font-size: 11px;
}

/* State History Panel */
.state-history-panel {
    margin: 8px;
    padding: 8px;
    background-color: rgb(45, 45, 45);
    border-radius: 4px;
}

.state-history-panel .header {
    font-weight: bold;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
}

.history-entry {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50, 50, 50);
}

.history-entry:last-child {
    border-bottom-width: 0;
}

.history-entry .timestamp {
    width: 80px;
    color: rgb(120, 120, 120);
    font-size: 10px;
}

.history-entry .arrow {
    margin: 0 8px;
    color: rgb(100, 100, 100);
}

.history-entry .state-name {
    flex-grow: 1;
}

.history-entry .state-name.from {
    color: rgb(180, 180, 180);
}

.history-entry .state-name.to {
    color: rgb(220, 220, 220);
}

.history-entry .duration {
    color: rgb(120, 180, 120);
    font-size: 10px;
    margin-left: 8px;
}

/* Blackboard Snapshot */
.blackboard-snapshot {
    margin: 8px;
    padding: 8px;
    background-color: rgb(45, 45, 45);
    border-radius: 4px;
}

.blackboard-snapshot .header {
    font-weight: bold;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
}

.variable-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 0;
}

.variable-row .key {
    width: 120px;
    color: rgb(180, 180, 180);
}

.variable-row .value {
    flex-grow: 1;
    color: rgb(150, 200, 255);
}

.variable-row .type {
    color: rgb(120, 120, 120);
    font-size: 10px;
    margin-left: 8px;
}

/* View Options */
.view-options {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgb(50, 50, 50);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

.view-options Toggle {
    margin: 0 8px;
}

.view-options .slider-container {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
}

.view-options .slider-container Label {
    margin-right: 8px;
    color: rgb(180, 180, 180);
}

/* Active State Highlight Animation */
@keyframes pulse-highlight {
    0% {
        border-color: rgb(50, 200, 50);
    }
    50% {
        border-color: rgb(100, 255, 100);
    }
    100% {
        border-color: rgb(50, 200, 50);
    }
}

.active-state-highlight {
    animation: pulse-highlight 1s ease-in-out infinite;
}

/* Transition Animation */
.transition-highlight {
    --edge-color: rgb(100, 255, 100);
    --edge-width: 4;
}

/* No Selection State */
.no-selection {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.no-selection Label {
    color: rgb(120, 120, 120);
    font-size: 14px;
}

/* Split View */
.split-view-container {
    flex-direction: row;
    flex-grow: 1;
}

.split-view-container .divider {
    width: 4px;
    background-color: rgb(35, 35, 35);
    cursor: ew-resize;
}

.split-view-container .divider:hover {
    background-color: rgb(68, 192, 255);
}

/* Compact Mode */
.compact .instance-item {
    padding: 3px 6px;
}

.compact .history-entry {
    padding: 2px 0;
    font-size: 11px;
}

/* Error/Warning States */
.error-state {
    background-color: rgba(200, 50, 50, 0.2);
    border-color: rgb(200, 50, 50);
}

.warning-state {
    background-color: rgba(200, 150, 50, 0.2);
    border-color: rgb(200, 150, 50);
}

/* Transition Timeline */
.timeline-toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 8px;
    background-color: rgb(50, 50, 50);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

.timeline-entry {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50, 50, 50);
}

.timeline-entry:hover {
    background-color: rgb(55, 55, 55);
}

.timeline-entry.selected {
    background-color: rgb(45, 65, 85);
    border-left-width: 3px;
    border-left-color: rgb(68, 192, 255);
}

.timeline-entry.diff-anchor {
    background-color: rgb(65, 55, 35);
    border-left-width: 3px;
    border-left-color: rgb(255, 180, 50);
}

/* Diff Row Styles */
.diff-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 12px;
}

.diff-row.added {
    background-color: rgba(50, 150, 50, 0.15);
}

.diff-row.removed {
    background-color: rgba(200, 50, 50, 0.15);
}

.diff-row.changed {
    background-color: rgba(200, 150, 50, 0.15);
}
